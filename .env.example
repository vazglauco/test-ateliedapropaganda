# Copie este arquivo para .env.local e preencha com o código recebido por e-mail.
# Ele é enviado no header X-Candidato em todas as requisições.
VITE_CANDIDATO_CODE=

# Base da API simulada (não precisa alterar).
VITE_API_URL=https://api-teste.ateliedepropaganda.com.br/

# Opcional: força um cenário em todas as requisições (lento | erro | vazio | conflito).
# Também é possível usar ?cenario=... na URL do app.
VITE_API_CENARIO=
